<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8DCAE3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="195dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            app:cardBackgroundColor="#A7E0C9"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_circle_gray"
                    android:contentDescription="Назад"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="#000000" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/titleCard"
                    android:layout_width="190dp"
                    android:layout_height="52dp"
                    android:layout_centerHorizontal="true"
                    app:cardBackgroundColor="#D9D9D9"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Настройки"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:textStyle="normal" />
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_below="@id/titleCard"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Аватар"
                    android:src="@drawable/ic_avatar" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/imgAvatar"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/radius_background"
                    android:paddingStart="14dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="5dp"
                    android:text="Реналь"
                    android:textColor="#222222"
                    android:textSize="14sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="22dp"
            android:paddingEnd="16dp">

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#35C7B8"
                android:text="Редактировать профиль"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnLanguage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#35C7B8"
                android:text="Язык"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#35C7B8"
                android:text="Уведомления"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnTextSize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#35C7B8"
                android:text="Размер шрифта"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="120dp"
                android:backgroundTint="#E54545"
                android:text="Выйти из аккаунта"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="16sp"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>