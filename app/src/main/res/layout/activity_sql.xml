<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            app:cardBackgroundColor="#A7E0C9"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_circle_gray"
                    android:contentDescription="Назад"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="#000000" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="4dp"
                    android:text="SQL"
                    android:textColor="#111111"
                    android:textSize="22sp"
                    android:textStyle="normal" />

                <androidx.cardview.widget.CardView
                    android:layout_width="134dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="2dp"
                    app:cardBackgroundColor="#D9D9D9"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Редактировать задачи"
                        android:textColor="#444444"
                        android:textSize="11sp" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvTitle"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Всего опыта: 90"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Уровень: 1"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="До следующего уровня: 10 опыта"
                        android:textColor="#111111"
                        android:textSize="15sp" />
                </LinearLayout>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#D9D9D9"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Список текущих задач"
                android:textColor="#111111"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#8DCAE3"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1 Освоить синтаксис и базовые операторы"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/check1"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Готово"
                        android:src="@drawable/ic_check_green_background" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="#444444" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2 Освоить различные запросы"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/check2"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Готово"
                        android:src="@drawable/ic_check_red_background" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="#444444" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3 Освоить агрегатные функции"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/check3"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Готово"
                        android:src="@drawable/ic_check_green_background" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="#444444" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4 Изучить основы реляционных БД"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/check4"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Готово"
                        android:src="@drawable/ic_check_red_background" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#D9D9D9"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Список следующих задач"
                android:textColor="#111111"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#8DCAE3"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1 Освоить подзапросы"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/check5"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Готово"
                        android:src="@drawable/ic_check_green_background" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="#444444" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2 Оперировать несколькими таблицами"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/check6"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Готово"
                        android:src="@drawable/ic_check_red_background" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="#444444" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3 Освоить агрегатные функции"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/check7"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Готово"
                        android:src="@drawable/ic_check_green_background" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="#444444" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4 Изучить оконные функции"
                        android:textColor="#111111"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/check8"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Готово"
                        android:src="@drawable/ic_check_red_background" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>